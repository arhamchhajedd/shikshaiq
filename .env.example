# ==============================================================================
# ShikshaIQ Environment Configuration
# Copy this file to .env.local and populate with your Supabase credentials.
# ==============================================================================

# Supabase Public Configuration (from Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: Server-only service role key for administrative functions (NEVER expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==============================================================================
# Socratic AI Tutor Configuration (Phase 06)
# Server-only API keys for AI tutoring. NEVER prefix with NEXT_PUBLIC_.
# Configure either Google Gemini or OpenAI:
# ==============================================================================

# Option A: Google Gemini (Recommended for NCERT tutoring)
# GEMINI_API_KEY=your-gemini-api-key-here

# Option B: OpenAI
# OPENAI_API_KEY=your-openai-api-key-here

# Optional: Specify provider explicitly ('gemini' or 'openai')
# AI_PROVIDER=gemini

# Optional: Override default model ('gemini-3.8-flash', 'gpt-4o-mini')
# AI_MODEL=gemini-3.8-flash
